{
  "Application": {
    "Name": "NttBank.Mcp",
    "Version": "1.0.0",
    "Description": "NttBank Model Context Protocol"
  },
  "Serilog": {
    "Filter": [
      {
        "Name": "ByExcluding",
        "Args": {
          "expression": "RequestPath like '/metrics' or RequestPath like '/health' or RequestPath like '/favicon%'"
        }
      }
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.AspNetCore": "Information",
        "System": "Information",
        "CorrelationId.CorrelationIdMiddleware": "Warning"
      }
    }
  }
}
