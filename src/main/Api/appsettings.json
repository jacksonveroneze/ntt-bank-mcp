{
  "Application": {
    "Name": "NttBank.Mcp",
    "Version": "1.0.0",
    "Description": "NttBank Model Context Protocol"
  },
  "Serilog": {
    "Filter": [
      {
        "Name": "ByExcluding",
        "Args": {
          "expression": "RequestPath like '/metrics' or RequestPath like '/metrics-open' or RequestPath like '/health' or RequestPath like '/favicon%'"
        }
      }
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.AspNetCore": "Information",
        "System": "Information",
        "CorrelationId.CorrelationIdMiddleware": "Warning"
      }
    }
  },
  "HttpClientNttBank": {
    "Name": "ntt-bank-api",
    "Address": "https://low2d.wiremockapi.cloud"
  },
  "AuthTokenAuthentication": {
    "Authority": "https://dev-e1dr7tee5q8cqgzk.us.auth0.com",
    "Issuer": "https://dev-e1dr7tee5q8cqgzk.us.auth0.com/",
    "Audience": "ntt-bank-mcp"
  },
  "AuthTokenGenerator": {
    "Audience": "ntt-bank-mcp"
  },
  "BranchCacheConfiguration": {
    "PrefixKey": "branch",
    "ExpirationMs": 30000
  }
}
